<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>14</LangVersion>
    <RootNamespace>AIGuiders.DotnetTools.NugetReadme</RootNamespace>
    <AssemblyName>AIGuiders.DotnetTools.NugetReadme</AssemblyName>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nuget-readme</ToolCommandName>
    <PackageId>AIGuiders.DotnetTools.NugetReadme</PackageId>
    <Description>Generate per-package NUGET.md readme pages from fact files — fixed six-section template, EOL from the repo's own .gitattributes (git check-attr), foreign layouts via project: header / --facts.</Description>
    <PackageTags>nuget;readme;generator;gitattributes;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Единственный источник логики — скрипт; тул компилирует его же как Program.cs.
         dotnet script и exe всегда из одного файла, копий нет. -->
    <Compile Include="..\..\scripts\build-nuget-readmes.csx" Link="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
